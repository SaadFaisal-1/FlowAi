# Copy this to .env and fill in your values
# NEVER commit .env to GitHub

# ── Database ──────────────────────────────────
# For local dev: leave as-is (SQLite auto-created)
# DATABASE_URL=sqlite:///./flowmind.db

# For MS SQL Server (optional):
# DATABASE_URL=mssql+pyodbc://sa:YourPass@localhost:1433/flowmind_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── OpenAI ────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── WhatsApp Cloud API ────────────────────────
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_permanent_access_token
WA_VERIFY_TOKEN=flowmind_secret_verify

# ── Google APIs ───────────────────────────────
# Paste the full service account JSON as a single line string.
# Sheets: share the target spreadsheet with the service account client_email.
# Gmail/Calendar: use OAuth authorized-user JSON, or a service account with domain-wide delegation.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Instagram (Meta Graph API) ────────────────
INSTAGRAM_TOKEN=your_instagram_graph_token

# ── App ───────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
JWT_SECRET_KEY=change_this_to_a_long_random_string
